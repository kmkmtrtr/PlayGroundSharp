<UserControl x:Class="PlayGroundSharp.App.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False" IsHitTestVisible="False">
    <StackPanel>
        <Grid x:Name="HeaderPanel" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="28" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="22" Height="22" CornerRadius="3"
                    Background="{DynamicResource SelectionBrush}"
                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                    VerticalAlignment="Top">
                <TextBlock x:Name="GlyphText" Text="C#" FontFamily="Cascadia Mono,Consolas"
                           FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="SignatureText" Grid.Column="1" TextWrapping="Wrap"
                       FontFamily="Cascadia Mono,Consolas" FontSize="12.5" LineHeight="19"
                       Foreground="{DynamicResource ForegroundBrush}" VerticalAlignment="Center" />
        </Grid>

        <Border x:Name="HeaderDivider" Height="1" Background="{DynamicResource BorderBrush}"
                Margin="0,0,0,10" />

        <Border x:Name="NoticePanel" Visibility="Collapsed" CornerRadius="4"
                Background="{DynamicResource HoverBrush}" BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="3,0,0,0" Padding="9,7" Margin="0,0,0,10">
            <TextBlock x:Name="NoticeText" TextWrapping="Wrap" FontSize="11.5" LineHeight="17"
                       Foreground="{DynamicResource ForegroundBrush}" />
        </Border>

        <StackPanel x:Name="SummarySection" Visibility="Collapsed">
            <TextBlock Text="{DynamicResource Assist.Summary}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       FontFamily="Segoe UI Variable Text,Segoe UI" FontSize="12.5" LineHeight="20"
                       Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>

        <StackPanel x:Name="ParametersSection" Visibility="Collapsed" Margin="0,11,0,0">
            <TextBlock Text="{DynamicResource Assist.Parameters}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
            <StackPanel x:Name="ParameterList" />
        </StackPanel>

        <StackPanel x:Name="ReturnsSection" Visibility="Collapsed" Margin="0,11,0,0">
            <TextBlock Text="{DynamicResource Assist.Returns}" FontSize="10" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
            <TextBlock x:Name="ReturnsText" TextWrapping="Wrap"
                       FontFamily="Segoe UI Variable Text,Segoe UI" FontSize="12.5" LineHeight="20"
                       Foreground="{DynamicResource ForegroundBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
