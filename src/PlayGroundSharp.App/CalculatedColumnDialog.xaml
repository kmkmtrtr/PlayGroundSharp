<Window x:Class="PlayGroundSharp.App.CalculatedColumnDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{DynamicResource Inspector.AddCalculatedColumn}"
        Width="720" Height="470" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Inspector.CalculatedColumnName}"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="ColumnNameText" Grid.Column="1" Padding="7,5"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     TextChanged="Input_TextChanged" />
        </Grid>

        <TextBlock Grid.Row="1" Text="{DynamicResource Inspector.CalculatedColumnFormula}"
                   Margin="0,14,0,5" />
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <avalonEdit:TextEditor x:Name="FormulaText" MinHeight="74" Padding="7,6"
                                   WordWrap="True" VerticalScrollBarVisibility="Auto"
                                   HorizontalScrollBarVisibility="Disabled"
                                   FontFamily="Cascadia Mono,Consolas"
                                   Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                                   BorderBrush="{DynamicResource BorderBrush}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource Inspector.CalculatedColumnFormulaHint}"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Inspector.CalculatedColumnGeneratedExpression}" Margin="0,0,0,5" />
            <TextBox x:Name="GeneratedExpressionText" Grid.Row="1" IsReadOnly="True"
                     Padding="7,6" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono,Consolas"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="CancelButton" Content="{DynamicResource Ui.Cancel}"
                    IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="ApplyButton" Content="{DynamicResource Inspector.AddCalculatedColumnAction}"
                    Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    Margin="8,0,0,0" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
