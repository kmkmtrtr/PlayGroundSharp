<Window x:Class="PlayGroundSharp.App.ColumnFilterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="{DynamicResource Inspector.FilterColumnTitle}"
        Width="460" Height="270" MinWidth="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Inspector.FilterColumnName}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock x:Name="ColumnNameText" Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Inspector.FilterOperator}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="OperatorCombo" Grid.Column="1" Padding="7,5"
                      SelectionChanged="OperatorCombo_SelectionChanged" />
        </Grid>
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource Inspector.FilterValue}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBox x:Name="ValueText" Grid.Column="1" Padding="7,5"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" />
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ClearButton" Content="{DynamicResource Inspector.ClearColumnFilter}"
                    Click="Clear_Click" Margin="0,0,8,0" />
            <Button Content="{DynamicResource Ui.Cancel}" IsCancel="True" />
            <Button Content="{DynamicResource Inspector.ApplyColumnFilter}"
                    Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    Margin="8,0,0,0" Click="Apply_Click" />
        </StackPanel>
    </Grid>
</Window>
