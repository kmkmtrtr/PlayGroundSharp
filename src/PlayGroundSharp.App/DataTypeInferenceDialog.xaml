<Window x:Class="PlayGroundSharp.App.DataTypeInferenceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{DynamicResource DataInference.Title}"
        Icon="Assets/PlayGroundSharp.ico"
        Width="800" Height="610" MinWidth="620" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource DataInference.Description}"
                   Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{DynamicResource DataInference.TypeName}" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="TypeNameText" Grid.Column="1" Padding="7,5" Margin="0,0,18,0"
                     AutomationProperties.Name="{DynamicResource DataInference.TypeName}"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" TextChanged="Input_TextChanged" />
            <TextBlock Grid.Column="2" Text="{DynamicResource DataInference.VariableName}"
                       VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBox x:Name="VariableNameText" Grid.Column="3" Padding="7,5"
                     AutomationProperties.Name="{DynamicResource DataInference.VariableName}"
                     Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                     BorderBrush="{DynamicResource BorderBrush}" TextChanged="Input_TextChanged" />
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock Text="{DynamicResource DataInference.Preview}" Margin="0,0,0,5" />
            <Border x:Name="WarningBorder" Background="{DynamicResource SelectionBrush}" CornerRadius="5"
                    Padding="9,6" Margin="0,0,0,8" Visibility="Collapsed">
                <TextBlock x:Name="WarningText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <avalonEdit:TextEditor x:Name="PreviewText" Grid.Row="3" IsReadOnly="True"
                               AutomationProperties.Name="{DynamicResource DataInference.Preview}"
                               Padding="8,7" FontFamily="Cascadia Mono,Consolas" FontSize="12"
                               ShowLineNumbers="True" WordWrap="False"
                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                               Background="{DynamicResource InputBrush}" Foreground="{DynamicResource ForegroundBrush}"
                               BorderBrush="{DynamicResource BorderBrush}" />

        <TextBlock x:Name="StatusText" Grid.Row="4" Margin="0,10,0,0"
                   Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                   AutomationProperties.LiveSetting="Polite" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{DynamicResource Ui.Cancel}" IsCancel="True" />
            <Button x:Name="GenerateButton" Content="{DynamicResource DataInference.GenerateAction}"
                    Style="{StaticResource AccentButtonStyle}" IsDefault="True"
                    Margin="8,0,0,0" Click="Generate_Click" />
        </StackPanel>
    </Grid>
</Window>
